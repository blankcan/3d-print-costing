# The Node service is private; Caddy is the only LAN-facing listener.
HOST=127.0.0.1
PORT=3001

# Keep the SQLite database and uploaded images outside the deployed source tree.
APP_DB_PATH=/var/lib/3d-print-costing/app.db

# The production app is served from the same origin as its API, so cross-origin
# browser access is disabled. Set a comma-separated allowlist only when needed.
CORS_ORIGINS=
